{
  "project": {
    "name": "SUBHXAXM Board Master",
    "short_name": "SUBHXAXM",
    "version": "1.0.0",
    "description": "Open-source Class 10 exam preparation platform with Claude AI",
    "license": "MIT",
    "target_board": "OAV Odisha",
    "target_class": 10,
    "target_percentage": 85
  },
  "ai_development_instructions": {
    "role": "Senior Full-Stack Developer",
    "instruction": "Build a complete, working, responsive Class 10 study website from this configuration. Preserve all specified features. Generate production-ready source code, not a static mockup.",
    "requirements": [
      "Use React and Vite for the frontend",
      "Use Node.js and Express for the backend",
      "Use the official Anthropic API for Claude",
      "Keep the Anthropic API key on the server",
      "Read the API key from environment variables",
      "Use modular components and clean architecture",
      "Make the application mobile-first",
      "Include loading states and error handling",
      "Use accessible HTML and keyboard navigation",
      "Create a README with setup and deployment instructions",
      "Test the production build",
      "Never fabricate textbook content or examination results"
    ]
  },
  "branding": {
    "website_name": "SUBHXAXM",
    "application_name": "SUBHXAXM Board Master",
    "tagline": "Study Smart. Build Your Future.",
    "logo_text": "S",
    "footer_text": "Built by SUBHXAXM",
    "theme": "dark",
    "colors": {
      "background": "#09090F",
      "surface": "#151521",
      "primary": "#8B5CF6",
      "secondary": "#06B6D4",
      "text": "#F8FAFC",
      "muted": "#94A3B8",
      "success": "#22C55E",
      "danger": "#EF4444"
    }
  },
  "technology": {
    "frontend": "React",
    "bundler": "Vite",
    "language": "JavaScript",
    "styling": "Tailwind CSS",
    "backend": "Node.js",
    "server": "Express",
    "ai_provider": "Anthropic",
    "database_initial": "LocalStorage",
    "database_production": "Optional PostgreSQL",
    "api_key_environment_variable": "ANTHROPIC_API_KEY"
  },
  "navigation": [
