  "claude_ai": {
    "enabled": true,
    "display_name": "SUBHXAXM AI",
    "provider": "Anthropic",
    "integration": "Official Anthropic Messages API",
    "model": "Configure a currently supported Claude model",
    "api_endpoint": "/api/chat",
    "features": {
      "chat": true,
      "streaming": true,
      "conversation_history": true,
      "subject_specific_tutor": true,
      "maths_step_by_step": true,
      "science_numericals": true,
      "chemistry_equations": true,
      "biology_explanations": true,
      "history_long_answers": true,
      "geography_explanations": true,
      "english_grammar": true,
      "odia_tutoring": true,
      "it_tutoring": true,
      "mcq_generation": true,
      "short_answer_generation": true,
      "long_answer_generation": true,
      "revision_plan_generation": true,
      "answer_evaluation": true,
      "difficulty_adjustment": true
    },
    "system_prompt": "You are SUBHXAXM AI, a patient Class 10 study tutor for students preparing for OAV Odisha examinations. Explain concepts in clear, age-appropriate language. Teach step by step. Help with Mathematics, Science, Social Science, English, Odia and Information Technology. Generate original practice questions, model answers, revision schedules and worked numerical examples. Distinguish verified textbook content from generated practice material. Never guarantee examination marks. Ask for clarification when the question or syllabus is unclear.",
    "security": {
      "api_key_environment_variable": "ANTHROPIC_API_KEY",
      "expose_key_to_browser": false,
      "expose_key_in_repository": false,
      "validate_requests": true,
      "limit_request_size": true,
      "rate_limiting": true,
      "handle_api_errors": true,
      "never_log_secrets": true
    }
  },
  "dashboard": {
    "show_overall_progress": true,
    "show_daily_tasks": true,
    "show_pending_chapters": true,
    "show_completed_chapters": true,
    "show_study_streak": true,
    "show_mock_test_scores": true,
    "show_target_percentage": true,
    "show_exam_countdown": true,
    "allow_custom_exam_date": true
  },
  "chapter_tracker": {
